# ==========================================
# DeepFake-Detection-Agent Configuration Template
# ==========================================

# 1. Google Gemini AI Key (for Observability LLM agent)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Hugging Face Token & Repositories (Option A Hub Separation + Option C Smart Namespace)
HF_TOKEN="hf_your_huggingface_token_here"
HF_DATASET_REPO="ThangCao/Threads-DFBench-Vietnamese"
HF_BASELINES_REPO="ThangCao/DualStream-Foundational-Manifests"

# 3. Meta Threads Crawler Configuration (Option A + C Hybrid)
# Profiles: quick_inspection | standard_daily | full_pentest | custom
CRAWL_PROFILE=quick_inspection

# Comma-separated list of search keywords for Vietnamese human media
THREADS_KEYWORDS=hcm,saigon,vietnam,thesinhvien,selfievietnam,hanoi,nguoivietnam,chandungvietnam,sinhvien,dslrvietnam,duongphovietnam,cmnd,cccd,viral

# Crawl Quotas
THREADS_MAX_IMAGES=250
THREADS_MAX_VIDEOS=50
THREADS_MAX_AUDIOS=50
SAMPLE_INSPECTION_COUNT=250

# Optional: Session cookies for authenticated Threads crawling
# THREADS_SESSION_COOKIES="sessionid=your_threads_sessionid; ds_user_id=your_user_id; csrftoken=your_csrftoken"

# 4. Google Drive Target Shared Folder ID
GDRIVE_TARGET_FOLDER_ID="1MipTWpXt0o0xz2IyUc_pTvMzo0tcXRlr"
