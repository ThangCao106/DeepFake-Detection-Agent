# ==========================================
# DeepFake-Detection-Agent Configuration Template
# ==========================================

# 1. Google Gemini AI Key (for Observability LLM agent)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Hugging Face Token (for fine-tuned model weights)
HF_TOKEN="hf_your_huggingface_token_here"

# 3. Meta Threads Crawler Configuration & Authentication
THREADS_HASHTAGS="#vietnam,#hcm,#cccd,#thesinhvien,#selfievietnam,#hanoi,#saigon,#duongphovietnam,#nguoivietnam,#chandungvietnam"
# THREADS_SESSION_COOKIES="sessionid=your_threads_sessionid; ds_user_id=your_user_id; csrftoken=your_csrftoken"

# 4. Google Drive Service Account Sync (Option A)
# Either paste the full JSON string of the Service Account key:
GDRIVE_CREDENTIALS_JSON='{"type": "service_account", "project_id": "deepfake-detection-drive", "private_key_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n", "client_email": "deepfake-gdrive-bot@deepfake-detection-drive.iam.gserviceaccount.com"}'
# Or specify relative/absolute file path:
# GDRIVE_CREDENTIALS_JSON="./credentials/gdrive-service-account.json"

# 5. Google Drive Target Shared Folder ID (Mandatory for Service Account)
# URL: https://drive.google.com/drive/folders/1s6G-cscNpEMBbUlvJfb4i24s9_7UVjet
GDRIVE_TARGET_FOLDER_ID="1s6G-cscNpEMBbUlvJfb4i24s9_7UVjet"
