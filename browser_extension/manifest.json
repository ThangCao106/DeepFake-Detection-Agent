{
  "manifest_version": 3,
  "name": "DeepTrace.io.vn - AI Forensic Shield",
  "short_name": "DeepTrace",
  "version": "1.1.0",
  "description": "DeepTrace.io.vn Client-Server Hybrid Deepfake & Synthetic Media Detection Extension for TikTok, Instagram Reels, Threads, YouTube Shorts, and Web Media.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://deeptrace.io.vn/*",
    "https://detection.dtpsoft.vn/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepTrace.io.vn — AI Forensic Shield",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.threads.net/*",
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "<all_urls>"
      ],
      "js": ["content_script.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "deeptrace@deeptrace.io.vn",
      "strict_min_version": "115.0"
    }
  }
}
